# Скопируй в .env и поправь под себя

# Модель Ollama (ollama pull qwen3:8b). Для слабой видеокарты: qwen3:4b
BIANCA_MODEL=qwen2.5:7b
# false — без режима рассуждений (быстрее); true / low / medium / high / auto
BIANCA_THINK=false
BIANCA_TEMPERATURE=0.6
OLLAMA_HOST_URL=http://127.0.0.1:11434

PORT=3000
HOST=0.0.0.0
# Если задан — телефон должен присылать его в заголовке X-Bianca-Token (обязательно при работе по Wi-Fi)
BIANCA_TOKEN=

# Сколько последних сообщений диалога помнить
BIANCA_MAX_HISTORY=40
